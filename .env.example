# Supabase — créer un projet sur https://supabase.com/dashboard
# Puis copier ce fichier en .env.local et remplir les valeurs.
# Settings → API → Project URL + Publishable key (sb_publishable_...)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key-here

# Suivi des erreurs (optionnel) — Sentry, projet React, région UE
# Settings → Client Keys (DSN). Sans cette variable, le suivi est inactif.
VITE_SENTRY_DSN=

# Lecture de la plaque par l'IA dans la fiche équipement (optionnel).
# Laisser vide tant que le secret ANTHROPIC_API_KEY n'est pas configuré dans Supabase.
VITE_LABEL_SCAN_ENABLED=
